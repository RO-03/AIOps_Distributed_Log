      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "aiops-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(total_events)::bigint AS value FROM batch_metrics",
          "refId": "A"
        }
      ],
      "title": "Total Events (7d)",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "aiops-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          },
          "mappings": []
        },
